# Terraform
**/.terraform/*
.terraform.lock.hcl.tmp
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Plans / gate artifacts (always regenerated by the gate)
tfplan.binary
tfplan*.json
gate-result.json

# Local evidence / logs (kept locally, not in the repo)
.evidence/

# Secrets — never commit
*.auto.tfvars
.env
*.pem

# cloud2code live import local artifacts
cloud2code/**/.terraform/
cloud2code/**/*.tfstate
cloud2code/**/*.tfstate.*
cloud2code/**/.local/
cloud2code/**/tfplan*
cloud2code/**/*.log
